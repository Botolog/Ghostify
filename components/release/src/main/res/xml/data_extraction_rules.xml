<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/extraction rules.

  cloud-backup: excluded entirely — an offline, no-account app must not push a
  user's Spotify library into cloud backups (PROJECT.md: no cloud storage).

  device-transfer: the Room database and shared preferences follow the phone on
  device-to-device transfer (T-179 friendly). MP3s are excluded — they are large
  and their absence is healed by the re-sync diff (PROJECT.md §6.2), which
  re-queues any song whose local file is missing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_file" path="." />
    </device-transfer>
</data-extraction-rules>
