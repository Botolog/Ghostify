<?xml version="1.0" encoding="utf-8"?>
<!--
  Light XML theme. It is only the window shell shown before Compose attaches
  (launch window, status/nav bar colors); all real theming happens in the
  Compose GhostifyTheme. Platform parents are used deliberately so this app
  does not depend on the View Material library.
-->
<resources>
    <style name="Theme.Ghostify" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ghostify_background</item>
        <!-- Transparent scrims for edge-to-edge: content draws behind system
             bars; the bars themselves are drawn by the system (transparent
             gesture nav, transparent 3-button via isNavigationBarContrastEnforced=false).
             Opaque colors here would leave a nav-keys-sized bald strip when the
             bars are hidden. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
