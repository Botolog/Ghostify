<?xml version="1.0" encoding="utf-8"?>
<!--
  Playlists launcher widget provider info (medium, 4x2 cells).

  initialLayout points at Glance's bundled loading layout; updatePeriodMillis=0 disables
  periodic polling (the running app pushes updates via WidgetUpdateCoordinator, and the
  widget otherwise renders from persisted state + Room).

  minResizeWidth/minResizeHeight are held at the 2x2 floor: below that the tile grid (and
  the name beside a cover) stops fitting. The widget is resizable both ways; PlaylistLayout
  derives the grid from the real cell size.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_playlist_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_preview_playlists"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
