<?xml version="1.0" encoding="utf-8"?>
<!--
  Player widget provider info (medium, 4x2 cells).

  initialLayout points at Glance's bundled loading layout; Glance replaces it with
  the composed RemoteViews. updatePeriodMillis=0 disables periodic polling: the
  running app pushes updates instead (see WidgetUpdateCoordinator).

  targetCellWidth/targetCellHeight are API 31+ attributes; older launchers fall
  back to minWidth/minHeight. minWidth/minHeight describe the default 4x2 cell;
  minResizeWidth/minResizeHeight let the user shrink all the way to the widget's
  single-row (2x1) form, which PlayerWidget lays out responsively.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_player_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:previewImage="@drawable/ic_no_song_cover"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
