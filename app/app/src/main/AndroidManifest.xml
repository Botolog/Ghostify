<?xml version="1.0" encoding="utf-8"?>
<!--
  Ghostify — canonical app manifest (Platform / Release Readiness).

  minSdk 26 / targetSdk 35. Chaquopy needs no manifest entries of its own.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: Spotify public metadata fetch + YouTube audio resolution/download. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Haptic feedback on swipe-to-queue gesture. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 13+ runtime permission for download / playback notifications.
         On API < 33 this is a normal permission that installs silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground services: background playback (MediaSessionService) and
         background downloads (WorkManager worker). Both type-specific permissions
         are required from targetSdk 34 onwards. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Media playback must survive screen-off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- No READ/WRITE storage permission: media lives in app-scoped storage
         (getExternalFilesDir) by default. MANAGE_EXTERNAL_STORAGE is requested
         only when the user explicitly chooses a custom storage folder (SAF picker). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Auto-update: install downloaded APK updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- No uses-feature restrictions: the app must remain installable on the
         full API 26+ device range. -->

    <application
        android:name=".GhostifyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ghostify"
        android:usesCleartextTraffic="false">

        <!-- Single-activity Compose app. Exported so the launcher can start it;
             singleTop so notification taps don't stack instances. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaSessionService. exported=false: controllers reach the
             session through the system's MediaSessionManager, never by binding
             this component directly. Hosts the shared PlaybackEngine session. -->
        <service
            android:name=".background.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Home-screen "Now Playing" widget (4x2). exported=false per the
             current official Glance docs ("Create an app widget with Glance"):
             the system delivers ACTION_APPWIDGET_UPDATE to this explicit
             component, and Glance's own trampoline activity/receivers are merged
             in from the glance-appwidget library manifest. Transport buttons use
             Glance ActionCallbacks, which need no extra manifest entries. -->
        <receiver
            android:name=".widget.PlayerWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_player_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/player_widget_info" />
        </receiver>

        <!-- Home-screen "Lyrics" widget (large, 4x4). Same cold-start rules as the
             player widget: rendered from persisted state + Room only, with live
             pushes from WidgetUpdateCoordinator. -->
        <receiver
            android:name=".widget.LyricsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_lyrics_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lyrics_widget_info" />
        </receiver>

        <!-- Home-screen "Sleep timer" widget (2x2). Same cold-start rules as the player
             widget: rendered from persisted state only (the countdown itself is never
             persisted), with live pushes from WidgetUpdateCoordinator while the app process
             is alive. Its buttons reach the container on tap. -->
        <receiver
            android:name=".widget.SleepTimerWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_sleep_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sleep_widget_info" />
        </receiver>

        <!-- Home-screen "Next up" / queue peek widget (4x3). Text-only; rendered from
             persisted state + Room on a cold start. -->
        <receiver
            android:name=".widget.NextUpWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_nextup_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nextup_widget_info" />
        </receiver>

        <!-- Home-screen "Shuffle Roulette" widget (4x2). Same cold-start rules; SPIN runs
             only on tap (container access) via ShuffleRouletteActionCallback. -->
        <receiver
            android:name=".widget.ShuffleRouletteWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_roulette_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/roulette_widget_info" />
        </receiver>

        <!-- Home-screen "Playlists" widget (4x2). A tile grid of the user's playlists;
             tapping a tile starts that playlist's playback on tap (container access) via
             PlaylistTileActionCallback. Cold start reads persisted state + Room only. -->
        <receiver
            android:name=".widget.PlaylistLauncherWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_playlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/playlist_widget_info" />
        </receiver>

        <!-- Home-screen "Library" widget (4x2): global sync status + library stats. Cold
             start reads Room aggregates + the persisted last-synced timestamp; the running
             app pushes live updates from WidgetUpdateCoordinator. -->
        <receiver
            android:name=".widget.LibraryStatsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_library_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/library_widget_info" />
        </receiver>

        <!-- FileProvider for sharing log files from Settings. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Media buttons (Bluetooth/headset) route here; Media3 connects the
             receiver to the active session. Must be exported for the system. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's foreground service backs long-running download workers.
             Its type must be redeclared here so it survives manifest merging
             (targetSdk 34+ throws InvalidForegroundServiceTypeException if a
             worker requests dataSync without the type being declared). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>
