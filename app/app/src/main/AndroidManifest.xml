<?xml version="1.0" encoding="utf-8"?>
<!--
  Ghostify — canonical app manifest (Platform / Release Readiness).

  minSdk 26 / targetSdk 35. Chaquopy needs no manifest entries of its own.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: Spotify public metadata fetch + YouTube audio resolution/download. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ runtime permission for download / playback notifications.
         On API < 33 this is a normal permission that installs silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground services: background playback (MediaSessionService) and
         background downloads (WorkManager worker). Both type-specific permissions
         are required from targetSdk 34 onwards. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Media playback must survive screen-off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- No READ/WRITE storage permission: media lives in app-scoped storage
         (getExternalFilesDir) by default. MANAGE_EXTERNAL_STORAGE is requested
         only when the user explicitly chooses a custom storage folder (SAF picker). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Auto-update: install downloaded APK updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- No uses-feature restrictions: the app must remain installable on the
         full API 26+ device range. -->

    <!-- Required on Android 11+ for media service discovery (Android Auto, Wear). -->
    <queries>
        <intent>
            <action android:name="androidx.media3.session.MediaLibraryService" />
        </intent>
    </queries>

    <application
        android:name=".GhostifyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ghostify"
        android:usesCleartextTraffic="false">

        <!-- Android Auto: declares media browsing capability. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Android Auto: tintable attribution icon for the car UI. -->
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_notification" />

        <!-- Single-activity Compose app. Exported so the launcher can start it;
             singleTop so notification taps don't stack instances. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaLibraryService. Must be exported so the system media
             browser (Android Auto, Wear OS, Bluetooth) can bind and browse
             the media tree via MediaBrowserService protocol. -->
        <service
            android:name=".background.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- Ghostify Car App Service for Android Auto lyrics display. -->
        <service
            android:name=".car.GhostifyCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>

        <!-- FileProvider for sharing log files from Settings. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Media buttons (Bluetooth/headset) route here; Media3 connects the
             receiver to the active session. Must be exported for the system. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's foreground service backs long-running download workers.
             Its type must be redeclared here so it survives manifest merging
             (targetSdk 34+ throws InvalidForegroundServiceTypeException if a
             worker requests dataSync without the type being declared). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>
